# Copy to `.env.local` for development. Never commit real secrets.

# --- Site -------------------------------------------------------------------
# Public origin used for canonical URLs, Open Graph and the preview watermark.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Plausible analytics domain. Leave empty to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Contact address shown in the footer, privacy and terms pages.
CONTACT_EMAIL=hello@hauntedportrait.example

# --- Pricing ----------------------------------------------------------------
# Single portrait price in US cents.
PRICE_SINGLE_CENTS=499
# Monster Pack price in US cents (chosen style + three more).
PRICE_PACK_CENTS=899
# Estimated provider cost per generation attempt, for the admin margin view.
GENERATION_COST_CENTS=4

# --- Image provider ---------------------------------------------------------
# mock | gemini
IMAGE_PROVIDER=mock
# Required when IMAGE_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_API_BASE=https://generativelanguage.googleapis.com
# Per-attempt generation budget in milliseconds.
GENERATION_TIMEOUT_MS=60000

# --- Payments ---------------------------------------------------------------
# mock | stripe
PAYMENT_PROVIDER=mock
# Required when PAYMENT_PROVIDER=stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com

# --- Turnstile --------------------------------------------------------------
# Off by default. Enable only when both keys are set (Cloudflare test keys are
# fine in development; never ship the test secret to production).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENFORCED=false

# --- Admin ------------------------------------------------------------------
# Password for /admin. Leave empty to disable the admin login (it fails closed).
ADMIN_PASSWORD=

# --- Secrets ----------------------------------------------------------------
# Signs download tokens. Required in production.
DOWNLOAD_SIGNING_SECRET=dev-download-signing-secret-change-me
# Signs the mock checkout webhook. Required in production.
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret-change-me
# Bearer token for GET /api/cron/cleanup. Required in production.
CRON_SECRET=dev-cron-secret-change-me

# --- Storage and KV ---------------------------------------------------------
# local | vercel-blob
STORAGE_DRIVER=local
# local | upstash
KV_DRIVER=local
# Directory used by the local drivers (dev and tests).
DATA_DIR=.data
# Vercel Blob token when STORAGE_DRIVER=vercel-blob.
BLOB_READ_WRITE_TOKEN=
# Upstash Redis REST credentials when KV_DRIVER=upstash.
KV_REST_URL=
KV_REST_TOKEN=

# --- Limits and retention ---------------------------------------------------
PREVIEW_LIMIT_PER_IP=3
DAILY_GENERATION_CAP=2000
RETENTION_HOURS=48
